# Copy this file to .env and adjust values as needed.
# .env is gitignored — never commit real secrets or local overrides.

# Port the Express server listens on. Defaults to 3000 if unset.
PORT=3000

# --- Alert Engine ---
# Master on/off switch for the alert engine.
# NOTE: documented here per PHASE5_PLAN.md's Configuration section, but not
# yet wired up to any actual runtime check anywhere in the code (a known,
# pre-existing gap — the alert engine currently always runs once started
# from server.js, regardless of this value). Flagged as a follow-up.
ALERTS_ENABLED=true
# Where alert rule definitions are persisted (JSON file, write-through on
# every create/update/delete via the API). Relative paths are resolved from
# the project root. On first-ever run (no file at this path yet), the engine
# seeds from config/defaultAlertRules.json instead.
ALERTS_RULES_PATH=./data/alertRules.json

# --- Discord notifier ---
# Both DISCORD_ENABLED=true and a non-empty DISCORD_WEBHOOK_URL are required
# for the Discord notifier to register at startup.
DISCORD_ENABLED=true
DISCORD_WEBHOOK_URL=

# --- Slack notifier ---
# Both SLACK_ENABLED=true and a non-empty SLACK_WEBHOOK_URL are required for
# the Slack notifier to register at startup.
SLACK_ENABLED=true
SLACK_WEBHOOK_URL=

# --- Email notifier ---
# EMAIL_ENABLED=true plus non-empty EMAIL_SMTP_HOST and EMAIL_TO are required
# for the email notifier to register at startup. EMAIL_SMTP_USER/PASS are
# optional — only used (as SMTP auth) if both are set, since some internal/
# local SMTP relays don't require authentication. Recommend testing against a
# sandbox SMTP provider (e.g. Ethereal, Mailtrap) rather than a real inbox.
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=alerts@sndhome.local
EMAIL_TO=

# --- Generic webhook notifier ---
# Both WEBHOOK_ENABLED=true and a non-empty WEBHOOK_URL are required for the
# webhook notifier to register at startup. If WEBHOOK_SECRET is set, every
# outgoing request body is signed with HMAC-SHA256 (hex digest) and sent as
# the X-SND-Signature header — the integration point for PagerDuty, Opsgenie,
# or any custom receiver not natively supported.
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=
