# Copy this file to .env and adjust values as needed.
# .env is gitignored — never commit real secrets or local overrides.

# Port the Express server listens on. Defaults to 3000 if unset.
PORT=3000

# --- Auth ---
# Opt-in Bearer-token auth (middleware/auth.js) for the mutating (POST/PUT/
# DELETE) endpoints under /api/alerts and /api/notifiers -- unset by default
# so a plain `npm start` still works unauthenticated for single-user homelab
# use. Set this to require `Authorization: Bearer <API_KEY>` on those
# endpoints (recommended before exposing this server beyond localhost/your
# own LAN). Read-only GET endpoints are never gated by this.
API_KEY=

# --- Alert Engine ---
# Master on/off switch for the alert engine. Defaults to enabled (unset or
# any value other than "false" behaves exactly like the old always-on
# behavior); set to "false" to skip starting the alert engine at all
# (server.js checks this before calling alertEngine.start()).
ALERTS_ENABLED=true
# Where alert rule definitions are persisted (JSON file, write-through on
# every create/update/delete via the API). Relative paths are resolved from
# the project root. On first-ever run (no file at this path yet), the engine
# seeds from config/defaultAlertRules.json instead.
ALERTS_RULES_PATH=./data/alertRules.json

# --- Persisted history (always-on monitoring) ---
# Metrics trend, alert transition, event log (auth/errors/warnings), and
# request log history all survive a server restart, not just a browser close
# -- write-through on a periodic snapshot (~30s), same JSON-file pattern as
# ALERTS_RULES_PATH/LAN_DEVICES_PATH above. Relative paths are resolved from
# the project root. Losing whatever changed since the last snapshot on a
# crash (worst case ~30s of history) is an accepted tradeoff for not writing
# to disk on every single 5s poll tick / HTTP request.
HISTORY_STORE_PATH=./data/metricsHistory.json
ALERT_HISTORY_PATH=./data/alertHistory.json
EVENT_LOG_PATH=./data/eventLog.json
REQUEST_LOG_PATH=./data/requestLog.json

# --- Discord notifier ---
# Both DISCORD_ENABLED=true and a non-empty DISCORD_WEBHOOK_URL are required
# for the Discord notifier to register at startup.
DISCORD_ENABLED=true
DISCORD_WEBHOOK_URL=

# --- Slack notifier ---
# Both SLACK_ENABLED=true and a non-empty SLACK_WEBHOOK_URL are required for
# the Slack notifier to register at startup.
SLACK_ENABLED=true
SLACK_WEBHOOK_URL=

# --- Email notifier ---
# EMAIL_ENABLED=true plus non-empty EMAIL_SMTP_HOST and EMAIL_TO are required
# for the email notifier to register at startup. EMAIL_SMTP_USER/PASS are
# optional — only used (as SMTP auth) if both are set, since some internal/
# local SMTP relays don't require authentication. Recommend testing against a
# sandbox SMTP provider (e.g. Ethereal, Mailtrap) rather than a real inbox.
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=alerts@sndhome.local
EMAIL_TO=

# --- Generic webhook notifier ---
# Both WEBHOOK_ENABLED=true and a non-empty WEBHOOK_URL are required for the
# webhook notifier to register at startup. If WEBHOOK_SECRET is set, every
# outgoing request body is signed with HMAC-SHA256 (hex digest) and sent as
# the X-SND-Signature header — the integration point for PagerDuty, Opsgenie,
# or any custom receiver not natively supported.
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- LAN Device Monitoring ---
# Where the known-device ledger (lan/deviceStore.js) is persisted. Relative
# paths are resolved from the project root.
LAN_DEVICES_PATH=./data/lanDevices.json
# Optional override for the subnet lan/lanEngine.js scans (CIDR, e.g.
# 192.168.1.0/24). Unset means lan/lanScanner.js auto-detects it from the
# first non-internal IPv4 interface reported by os.networkInterfaces() --
# which can pick the wrong one on a host with more than one active interface
# (VPN, a Docker virtual bridge, multiple NICs), silently scanning a
# different subnet than your actual LAN and undercounting devices that were
# never even in range to begin with. If the device count this tool reports
# doesn't match reality, check `ip addr` / `ifconfig` for other active
# interfaces before assuming it's a detection bug, and set this explicitly
# to confirm.
LAN_SCAN_CIDR=
# Optional: MAC address of a single device to surface a dedicated online/
# offline status card for (GET /api/pi-status), e.g. a Raspberry Pi agent
# host. Reuses the existing LAN scan above -- no separate polling or
# credentials are involved, so this only ever reflects a device already
# visible to that scan. Unset means GET /api/pi-status returns
# {configured: false} and no card-worthy data exists. Find a device's MAC
# via GET /api/lan/devices once it's been seen by a scan at least once.
PI_MONITOR_MAC=

# --- Cloudflare Tunnel (optional) ---
# Only used by the `cloudflared` service in docker-compose.yml (profile
# "tunnel" -- `docker compose --profile tunnel up`). Get this token from the
# Cloudflare Zero Trust dashboard: Networks > Tunnels > create a tunnel >
# "Docker" install method shows the full `tunnel run --token ...` command,
# copy just the token. Leave unset (and don't use the tunnel profile) to
# skip Cloudflare Tunnel entirely -- everything else in this file is
# unaffected either way. See PHASE6_CLOUDFLARE_TUNNEL_PLAN.md for full setup
# steps.
#
# SECURITY: this only gets traffic to your origin -- it does not add
# authentication. API_KEY above still only gates mutating alert/notifier
# endpoints and all of /api/lan (see the Auth section's own comment above);
# every other GET endpoint (system stats, alert rules/history, health) is
# public to anyone who reaches your tunnel hostname. Put Cloudflare Access
# (Zero Trust > Access > Applications) in front of the tunnel hostname if
# you want real authentication before exposing this beyond your LAN.
CLOUDFLARE_TUNNEL_TOKEN=
